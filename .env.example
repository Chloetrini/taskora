# Copy to .env.local (local) or add these in Vercel → Settings → Environment Variables.
# Never commit real values.

# --- Required ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=taskora
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=

# --- Your site's public address (no trailing slash). Used for emailed links, Google
#     sign-in, canonical links, the sitemap and share previews. Set it in production.
APP_URL=http://localhost:3000

# --- Email (sign-up verification + password reset), via Resend ---
# Without RESEND_API_KEY: development prints the emails (with their links) in the terminal;
# production answers 503 on sign-up and password reset.
RESEND_API_KEY=
# An address on a domain you verified in Resend. The default onboarding@resend.dev
# only delivers to the Resend account owner, so real users would never get their link.
EMAIL_FROM="Taskora <no-reply@your-domain.com>"

# --- Optional: Sign in with Google (see AGENTS.md, Section 10) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Local end-to-end testing only ---
# DISABLE_RATE_LIMIT=1
