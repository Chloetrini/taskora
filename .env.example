# Copy to .env.local (local) or add these in Vercel → Settings → Environment Variables.

# --- Required ---
MONGODB_URI=
MONGODB_DB=
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=

# --- Your site's public address (no trailing slash). Used for emailed links, Google
#     sign-in, canonical links, the sitemap and share previews. Set it in production.
APP_URL=

# --- Email (sign-up verification + password reset), via Brevo ---
# Without BREVO_API_KEY or EMAIL_FROM: development prints the emails (with their links) in the
# terminal; production answers 503 on sign-up and password reset.
# API key: Brevo → SMTP & API → API keys (starts with xkeysib-). Not the SMTP password.
BREVO_API_KEY=
# A sender you verified in Brevo (Senders, domains & dedicated IPs). Any other address is rejected.
# Best: an address on a domain you verified there. A Yahoo/Gmail address can land in spam.
EMAIL_FROM="Taskora <you@your-domain.com>"

# --- Optional: read cache via MemCachier . Leave empty to turn it off. ---
# Task lists, stats and trash are cached per user, encrypted, and refreshed on every change.
MEMCACHIER_SERVERS=
MEMCACHIER_USERNAME=
MEMCACHIER_PASSWORD=

# --- Optional: Sign in with Google (see AGENTS.md, Section 10) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Local end-to-end testing only ---
# DISABLE_RATE_LIMIT=1
